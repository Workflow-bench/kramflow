# Copy to .env.local and set a real value before deploying.
# Never commit .env.local — it's gitignored.

# Supabase project — see supabase/schema.sql for the tables these back and
# docs/ARCHITECTURE.md for why. Create a project at supabase.com, run
# schema.sql once in its SQL Editor, then copy these from
# Project Settings -> API.
#
# Real per-operator authentication (signup/login/logout, password hashing,
# session expiry) runs on Supabase Auth — no separate auth secret needed.
# Enable Email auth for the project (Authentication -> Providers) and decide
# whether to require email confirmation (Authentication -> Settings) before
# operators can sign up and log in.

# Project URL. Safe to expose to the client (NEXT_PUBLIC_) — Realtime,
# public reads, and the Supabase Auth client all use this.
NEXT_PUBLIC_SUPABASE_URL=

# anon public key. Safe to expose to the client — Row Level Security
# (supabase/schema.sql) restricts it to read-only on public tables, and it's
# also the key Supabase Auth uses for signup/login/logout (auth has its own
# access controls independent of table RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role secret key. Server-only, used by API routes for writes —
# bypasses Row Level Security entirely. Never prefix with NEXT_PUBLIC_,
# never send to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — sends the collaborator-invite email (email + temporary password,
# lib/server/email.ts). Both optional: if either is unset, inviting an
# email still creates the account/temp password and the pending invite row,
# it just skips the send — the owner always gets a copyable accept link
# too. This is separate from whatever SMTP is configured for Supabase
# Auth's own emails (Authentication -> Emails in the Supabase dashboard) —
# that's for Supabase's own confirm/recovery flows, and can't send this
# app's custom invite content.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="KramFlow <notifications@kramflow.me>"

# Anthropic — powers the optional AI features: cue-sheet import from any
# document, pre-show readiness review, alert/broadcast drafting, and the
# post-show summary. Optional: with no key the app runs exactly as before and
# the AI buttons don't appear. Server-only — never prefix with NEXT_PUBLIC_.
# Get a key at console.anthropic.com. Document text and cue-sheet details are
# sent to Anthropic when these features are used.
ANTHROPIC_API_KEY=
# Models. Alert drafting uses the fast one; cue-sheet import, the readiness
# review and the post-show summary use the quality one. Both optional.
# Defaults: claude-haiku-4-5 (fast) and claude-sonnet-5 (quality).
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_QUALITY=
